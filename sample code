import asyncio
import logging
import random

import httpx
from fastmcp.exceptions import ToolError

logger = logging.getLogger(__name__)


async def call_upstream(url: str) -> dict:
    attempts = 3

    for attempt in range(attempts):
        try:
            async with httpx.AsyncClient(timeout=5.0) as client:
                response = await client.get(url)
                response.raise_for_status()
                return response.json()

        except (httpx.TimeoutException, httpx.NetworkError) as exc:
            if attempt == attempts - 1:
                logger.exception("Upstream network failure")
                raise ToolError(
                    "UPSTREAM_UNAVAILABLE: The dependency is temporarily "
                    "unavailable. Retry later."
                ) from exc

        except httpx.HTTPStatusError as exc:
            status = exc.response.status_code

            if status == 429 and attempt < attempts - 1:
                retry_after = exc.response.headers.get("Retry-After")
                delay = float(retry_after) if retry_after else 2**attempt
                await asyncio.sleep(delay)
                continue

            if 500 <= status < 600 and attempt < attempts - 1:
                delay = (2**attempt) + random.uniform(0, 0.25)
                await asyncio.sleep(delay)
                continue

            logger.exception("Upstream HTTP error: %s", status)
            raise ToolError(
                "UPSTREAM_FAILURE: The dependency rejected or failed "
                "the request."
            ) from exc

        await asyncio.sleep((2**attempt) + random.uniform(0, 0.25))

    raise ToolError("UPSTREAM_UNAVAILABLE: Retry later.")
